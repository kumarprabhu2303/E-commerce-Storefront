<%- include('partials/header') %>
<div class="max-w-7xl mx-auto px-6 py-10 grid grid-cols-1 lg:grid-cols-3 gap-8">
  <div class="bg-white p-6 rounded-xl border shadow-sm h-fit">
    <h3 class="font-extrabold text-lg text-slate-800 mb-4">Add Inventory Item</h3>
    <form method="POST" action="/api/products" class="space-y-4">
      <div><label class="text-xs font-bold uppercase text-gray-500">Product Name</label><input type="text" name="name" required class="w-full border p-2 rounded-lg" /></div>
      <div class="grid grid-cols-2 gap-4">
        <div><label class="text-xs font-bold uppercase text-gray-500">Price ($)</label><input type="number" step="0.01" name="price" required class="w-full border p-2 rounded-lg" /></div>
        <div><label class="text-xs font-bold uppercase text-gray-500">Stock Qty</label><input type="number" name="stock" required class="w-full border p-2 rounded-lg" /></div>
      </div>
      <div><label class="text-xs font-bold uppercase text-gray-500">Category</label><input type="text" name="category" required class="w-full border p-2 rounded-lg" /></div>
      <div><label class="text-xs font-bold uppercase text-gray-500">Image Asset URL</label><input type="text" name="image" required class="w-full border p-2 rounded-lg" /></div>
      <div><label class="text-xs font-bold uppercase text-gray-500">Description</label><textarea name="description" required class="w-full border p-2 rounded-lg h-20 resize-none"></textarea></div>
      <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 rounded-lg transition">Publish to Catalog</button>
    </form>
  </div>

  <div class="lg:col-span-2 space-y-8">
    <div class="bg-white rounded-xl border shadow-sm overflow-hidden">
      <div class="p-4 bg-gray-100 font-bold text-slate-700 border-b">Active Store Catalog</div>
      <table class="w-full text-sm text-left">
        <thead class="bg-gray-50 border-b text-xs font-bold text-gray-600 uppercase">
          <tr><th class="p-4">Item Details</th><th class="p-4">Price</th><th class="p-4">Stock Adjust</th></tr>
        </thead>
        <tbody class="divide-y">
          <% products.forEach(prod => { %>
            <tr>
              <td class="p-4 font-semibold text-slate-800"><%= prod.name %></td>
              <td class="p-4 text-blue-600 font-bold">$<%= prod.price %></td>
              <td class="p-4">
                <form method="POST" action="/api/products/<%= prod._id %>/stock" class="flex gap-2">
                  <input type="number" name="stock" value="<%= prod.stock %>" class="w-16 border rounded p-1 text-center font-bold" />
                  <button type="submit" class="bg-slate-800 text-white text-xs px-2 py-1 rounded">Update</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="bg-white rounded-xl border shadow-sm overflow-hidden">
      <div class="p-4 bg-gray-100 font-bold text-slate-700 border-b">Recent Orders Ledger</div>
      <table class="w-full text-sm text-left">
        <thead class="bg-gray-50 border-b text-xs font-bold text-gray-600 uppercase">
          <tr><th class="p-4">Session Token Reference</th><th class="p-4">Customer</th><th class="p-4">Paid Total</th></tr>
        </thead>
        <tbody class="divide-y font-mono text-xs">
          <% orders.forEach(ord => { %>
            <tr>
              <td class="p-4 text-gray-500 truncate max-w-xs"><%= ord.stripeSessionId %></td>
              <td class="p-4 font-sans font-medium text-slate-700"><%= ord.userId ? ord.userId.name : 'Unknown Account' %></td>
              <td class="p-4 font-sans font-bold text-emerald-600">$<%= ord.totalAmount %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('partials/header') %>