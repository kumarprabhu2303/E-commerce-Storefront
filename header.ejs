<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>E-Commerce Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">
  <nav class="bg-slate-900 text-white shadow-md">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href="/" class="text-2xl font-bold tracking-wide text-blue-400">⚡ StoreFront</a>
      <div class="flex items-center space-x-6 font-medium">
        <a href="/" class="hover:text-blue-400 transition">Catalog</a>
        <a href="/cart" class="hover:text-blue-400 transition">🛒 Cart (<span id="cart-nav-count">0</span>)</a>
        <% if (user) { %>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="bg-blue-600 px-3 py-1.5 rounded hover:bg-blue-700 transition">Dashboard</a>
          <% } %>
          <span class="text-gray-400">Hi, <%= user.name %></span>
          <a href="/api/auth/logout" class="text-red-400 hover:text-red-500 text-sm">Logout</a>
        <% } else { %>
          <a href="/login" class="hover:text-blue-400 transition">Login</a>
          <a href="/register" class="border border-blue-400 px-3 py-1 rounded text-blue-400 hover:bg-blue-400 hover:text-slate-900 transition">Register</a>
        <% } %>
      </div>
    </div>
  </nav>
  <script>
    function updateNavCart() {
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      document.getElementById('cart-nav-count').innerText = cart.reduce((sum, item) => sum + item.quantity, 0);
    }
    window.addEventListener('DOMContentLoaded', updateNavCart);
  </script>
  <main class="flex-1">